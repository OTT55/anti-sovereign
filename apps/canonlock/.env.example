# All optional — sensible local defaults apply if unset.

# Where the SQLite database file lives. Defaults to ./canonlock.sqlite
# CANONLOCK_DB_PATH=./canonlock.sqlite

# RFC 3161 Time-Stamp Authority endpoint used to independently timestamp
# every registration. Defaults to the public freetsa.org TSA.
# CANONLOCK_TSA_URL=https://freetsa.org/tsr

# Hex-encoded 32-byte HMAC signing key. If unset, one is generated on first
# run and persisted to .canonlock_secret (gitignored) next to the app.
# CANONLOCK_SIGNING_KEY=
