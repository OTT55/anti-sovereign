# All optional — sensible local defaults apply if unset.

# Where the SQLite database file lives. Defaults to ./framevault.sqlite
# FRAMEVAULT_DB_PATH=./framevault.sqlite

# Shared secrets. If unset, generated once and persisted to .framevault_secrets
# (gitignored). Other CreativeOS apps need FRAMEVAULT_SERVICE_KEY to match the
# value in that file to call /api/credit.
# FRAMEVAULT_SIGNING_KEY=
# FRAMEVAULT_SESSION_KEY=
# FRAMEVAULT_SERVICE_KEY=
