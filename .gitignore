# Python (venv/.venv/ENV below already cover a venv's own lib/lib64 dirs —
# no bare lib/ pattern here, since that would also swallow the TypeScript
# rewrite's src/lib/ source directories)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
ENV/

# Database & Local State & Secrets
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.env
.env.*
*.env
*.env.txt
.env.local
.*_secret
!.env.example
!**/.env.example

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Node / TypeScript monorepo
node_modules/
.next/
.turbo/
dist/
*.tsbuildinfo
.pnpm-store/
next-env.d.ts
